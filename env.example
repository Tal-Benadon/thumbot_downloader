# ThumbBot Downloader Configuration
# Copy this file to .env and customize the values

# ================================
# COBALT API SETTINGS
# ================================

# Cobalt API instance URL (local Docker instance by default)
COBALT_API_URL=http://localhost:9000

# Video quality preference
# Options: max, 8k+, 4k, 1440p, 1080p, 720p, 480p, 360p, 240p, 144p
VIDEO_QUALITY=1080p

# Video codec preference  
# Options: h264 (best compatibility), av1 (best quality), vp9 (good quality)
VIDEO_CODEC=h264

# Audio format preference
# Options: best, mp3, ogg, wav, opus
AUDIO_FORMAT=best

# Multiple files handling (when platform returns multiple videos)
# Options: first, last, all, best
PICKER_BEHAVIOR=first

# Maximum file size in bytes (Discord limits)
# 8388608 = 8MB (free), 26214400 = 25MB (nitro basic), 104857600 = 100MB (nitro)
MAX_FILE_SIZE=8388608

# OR set max file size in MB (easier to configure)
# MAX_FILE_SIZE_MB=8.0

# ================================
# DISCORD SETTINGS  
# ================================

# Discord file upload limit (should match MAX_FILE_SIZE)
DISCORD_FILE_LIMIT=8388608

# Discord bot token (required for Discord integration)
# DISCORD_TOKEN=your_discord_bot_token_here

# ================================
# PLATFORM-SPECIFIC SETTINGS
# ================================

# Allow H.265 for TikTok (better quality but worse compatibility)
TIKTOK_H265=false

# Convert Twitter looping videos to GIF
TWITTER_GIF=false

# YouTube dubbed language preference (e.g., "en", "es", "fr")
# YOUTUBE_DUB_LANG=en

# ================================
# GENERAL SETTINGS
# ================================

# Enable debug mode
DEBUG_MODE=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Temporary directory for downloads
TEMP_DIR=./video_temp_dir

# Auto cleanup downloaded files after upload
AUTO_CLEANUP=true

# ================================
# ADVANCED SETTINGS
# ================================

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Download timeout in seconds  
DOWNLOAD_TIMEOUT=300

# Maximum retry attempts
MAX_RETRIES=3

# Strip metadata from downloaded files
DISABLE_METADATA=false

# ================================
# FALLBACK BEHAVIOR
# ================================
# 
# ThumbBot automatically tries fallback settings when the preferred 
# options aren't available for a video:
#
# Quality Fallbacks (in order):
# 1080p -> 720p -> 480p -> 360p -> 240p
#
# Codec Fallbacks (in order):  
# h264 -> vp9 -> av1
# (h264 most compatible, av1 best quality)
#
# Audio Fallbacks (in order):
# best -> mp3 -> ogg -> opus -> wav
#
# This ensures downloads succeed even when preferred settings
# aren't supported by the source platform.